Package: naboer
Version: 0.0.1.9000
Title: Dependence-Aware Cross-Validation Neighbourhoods
Authors@R: c(person(given = "Gavin L.", family = "Simpson",
                    email = "ucfagls@gmail.com",
                    role = c("aut", "cre", "cph"),
